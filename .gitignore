/.flattened-pom.xml
.claude
/.claude

# Eclipse project files
.classpath
.project
.settings/

# VS Code project files
.vscode/

# Local build artifacts
build_clean/
**/build_clean/
classpath.txt
**/classpath.txt
sources.txt
**/sources.txt

# MiRoVA cluster: generated demand inputs and run artifacts.
# The demand CSVs themselves ARE tracked. They are derived - the offline Python pipeline
# rebuilds them from the detector database - but that database is not public, so without
# them in the repository a study is not reproducible by anyone who cannot reach it. All
# thirty-two together are under two megabytes. The comparison PNGs beside them stay out:
# they are pure control plots, twice the size of the data, and regenerable from the CSVs.
cluster/demand/*.png
cluster/cp.txt
cluster/run_list.txt
cluster/logs/
cluster/output/

# Profiling artefacts: JFR recordings, raw jfr-print exports and profiling matrix run output.
# Individual files run past a gigabyte and every one of them is reproducible from a run, so
# none of it belongs in the repository. The findings live in docs/mirova/ instead.
profiling/
*.jfr

# Locally generated runtime classpath for the GUI demo script.
cluster/cp_gui.txt

# Local parallel-run scratch
cluster/.cp_local.txt

# Local run output (trajectories, detector data, logs, defect counters).
out/
