    <ots:Node Id="R7_8" Coordinate="(-20.765, 974.035)"   /> -->

     <!--
      Freiburg Nord interchange transcribed from ViSSim links 1-7.
      Coordinates in metres: X=East, Y=North.

      Mainline (south to north):
        L1a  N1_1 -> N1_4   2 lanes
        L2a  N1_4 -> N2_3   3 lanes, Offset=-3.6m  (FORWARD3 at -1.8m = exit-ramp zone)
        L3a  N2_3 -> N3_4   2 lanes
        L4a  N3_4 -> N4_3   3 lanes, Offset=-3.6m  (FORWARD3 at -1.8m = entry-ramp zone)
        L5a  N4_3 -> N5_3   2 lanes

      Lane alignment at junctions (OffsetStart/End arithmetic):
        2-lane FORWARD1=5.4m, FORWARD2=1.8m
        3-lane with Offset=-3.6m:
          FORWARD1=9.0-3.6=5.4m  -> connects to 2-lane FORWARD1
          FORWARD2=5.4-3.6=1.8m  -> connects to 2-lane FORWARD2
          FORWARD3=1.8-3.6=-1.8m -> new rightmost lane (ramp zone, no match)

      Exit ramp (ViSSim link 6): L_exit Bezier with OffsetStart=-3.6m connects
        FORWARD1 at -1.8m to L2a.FORWARD3. Then Polyline L6_ramp through the loop.
      Entry ramp (ViSSim link 7): Polyline L7a, then Bezier L7m with OffsetEnd=-3.6m
        connects FORWARD1 at -1.8m to L4a.FORWARD3.

      Note: ramp segments use Polyline (not Arc) because ViSSim spline polypoints
      do not form exact circular arcs between the chosen node pairs.
    -->

    <!-- Mainline nodes -->
    <ots:Node Id="N1_1" Coordinate="(-2.320, -0.117)"    Direction="85.2 deg(E)" />
    <ots:Node Id="N1_4" Coordinate="(10.759, 522.867)"   Direction="92.73 deg(E)" />
    <ots:Node Id="N2_3" Coordinate="(-0.003, 748.552)"   /> 
    <!-- Direction="96.67 deg(E)"  -->
    <ots:Node Id="N3_4" Coordinate="(-26.438, 974.797)"  Direction="99.08 deg(E)" />
    <ots:Node Id="N4_3" Coordinate="(-57.909, 1171.765)" Direction="100.87 deg(E)" />
    <ots:Node Id="N5_3" Coordinate="(-247.133, 1888.565)" Direction="101.2 deg(E)" />

    <!-- Exit ramp terminal nodes (ViSSim link 6 first and last polypoints) -->
    <ots:Node Id="R6_1" Coordinate="(2.967, 754.174)"    Direction="91.4 deg(E)" />
    <ots:Node Id="R6_8" Coordinate="(126.526, 659.974)"  Direction="-94.0 deg(E)" />

    <!-- Entry ramp nodes (ViSSim link 7: R7_1=generator origin, R7_8=merge connector start) -->
    <ots:Node Id="R7_1" Coordinate="(160.0, 725.0)"  Direction="96.6 deg(E)" />
    <ots:Node Id="R7_8" Coordinate="(-20.765, 974.035)"  Direction="103.7 deg(E)" />

    <!-- ================================================================
         MAINLINE
         ================================================================ -->

    <!-- L1a: 2-lane (ViSSim link 1) -->
    <ots:Link Id="L1a" NodeStart="N1_1" NodeEnd="N1_4" Type="HIGHWAY">
      <ots:Polyline>
      <ots:Coordinate>(-0.295, 22.747)</ots:Coordinate>
        <ots:Coordinate>(1.801, 45.606)</ots:Coordinate>
        <ots:Coordinate>(3.754, 68.475)</ots:Coordinate>
        <ots:Coordinate>(5.346, 91.370)</ots:Coordinate>
        <ots:Coordinate>(9.286, 164.839)</ots:Coordinate>
        <ots:Coordinate>(12.370, 238.357)</ots:Coordinate>
        <ots:Coordinate>(14.393, 311.906)</ots:Coordinate>
        <ots:Coordinate>(15.147, 385.469)</ots:Coordinate>
        <ots:Coordinate>(14.681, 419.829)</ots:Coordinate>
        <ots:Coordinate>(13.514, 454.177)</ots:Coordinate>
        <ots:Coordinate>(12.066, 488.521)</ots:Coordinate>
      </ots:Polyline>
      <ots:DefinedLayout>2LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- L2a: 3-lane (ViSSim link 2).
         OffsetStart/End=-3.6m: FORWARD1/2 align with L1a/L3a; FORWARD3 is the exit-ramp zone.  -->
    <ots:Link Id="L2a" NodeStart="N1_4" NodeEnd="N2_3" Type="HIGHWAY" OffsetStart="-3.6m" OffsetEnd="-3.6m">
        <ots:Straight />
      <!-- <ots:Polyline>
        <ots:Coordinate>(8.155, 659.241)</ots:Coordinate>
      </ots:Polyline> -->
      <ots:DefinedLayout>3LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- L3a: 2-lane (ViSSim link 3) -->
    <ots:Link Id="L3a" NodeStart="N2_3" NodeEnd="N3_4" Type="HIGHWAY">
    <!-- <ots:Straight /> -->
      <ots:Polyline>
        <ots:Coordinate>(-8.511, 822.470)</ots:Coordinate>
        <ots:Coordinate>(-25.995, 971.629)</ots:Coordinate>
      </ots:Polyline>
      <ots:DefinedLayout>2LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- L4a: 3-lane (ViSSim link 4).
         OffsetStart/End=-3.6m: FORWARD1/2 align with L3a/L5a; FORWARD3 is the entry-ramp zone. -->
    <ots:Link Id="L4a" NodeStart="N3_4" NodeEnd="N4_3" Type="HIGHWAY"
              OffsetStart="-3.6m" OffsetEnd="-3.6m">
              <ots:Straight />
      <!-- <ots:Polyline>
        <ots:Coordinate>(-36.703, 1060.734)</ots:Coordinate>
      </ots:Polyline> -->
      <ots:DefinedLayout>3LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- L5a: 2-lane (ViSSim link 5) -->
    <ots:Link Id="L5a" NodeStart="N4_3" NodeEnd="N5_3" Type="HIGHWAY">
    <ots:Polyline>
        <ots:Coordinate>(-59.782, 1182.629)</ots:Coordinate>
        <ots:Coordinate>(-61.637, 1193.496)</ots:Coordinate>
        <ots:Coordinate>(-63.528, 1204.357)</ots:Coordinate>
        <ots:Coordinate>(-65.509, 1215.201)</ots:Coordinate>
        <ots:Coordinate>(-76.362, 1273.316)</ots:Coordinate>
        <ots:Coordinate>(-87.401, 1331.403)</ots:Coordinate>
        <ots:Coordinate>(-99.217, 1389.321)</ots:Coordinate>
        <ots:Coordinate>(-112.401, 1446.930)</ots:Coordinate>
        <ots:Coordinate>(-129.275, 1511.757)</ots:Coordinate>
        <ots:Coordinate>(-147.646, 1576.189)</ots:Coordinate>
        <ots:Coordinate>(-166.966, 1640.360)</ots:Coordinate>
        <ots:Coordinate>(-186.684, 1704.400)</ots:Coordinate>
        <ots:Coordinate>(-201.325, 1750.591)</ots:Coordinate>
        <ots:Coordinate>(-216.490, 1796.616)</ots:Coordinate>
        <ots:Coordinate>(-231.864, 1842.574)</ots:Coordinate>
      </ots:Polyline>
      <ots:DefinedLayout>2LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- ================================================================
         EXIT RAMP (ViSSim link 6)
         L_exit: Bezier with OffsetStart=-3.6m places FORWARD1 at 1.8-3.6=-1.8m
           at N2_3, matching L2a.FORWARD3 there.
         L6_ramp: Polyline through all ViSSim link-6 intermediate polypoints.
         ================================================================ -->

    <ots:Link Id="L_exit" NodeStart="N2_3" NodeEnd="R6_1" Type="LOCAL" OffsetStart="-3.6m">
      <ots:Bezier />
      <ots:DefinedLayout>1LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <ots:Link Id="L6_ramp" NodeStart="R6_1" NodeEnd="R6_8" Type="LOCAL">
      <ots:Polyline>
       <ots:Coordinate>(2.525, 760.677)</ots:Coordinate>
        <ots:Coordinate>(1.892, 767.199)</ots:Coordinate>
        <ots:Coordinate>(1.643, 773.685)</ots:Coordinate>
        <ots:Coordinate>(2.352, 780.078)</ots:Coordinate>
        <ots:Coordinate>(4.387, 787.600)</ots:Coordinate>
        <ots:Coordinate>(7.259, 794.917)</ots:Coordinate>
