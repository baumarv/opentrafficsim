      <ots:Bezier />
      <ots:DefinedLayout>1LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- Second part of entry ramp (RAMP80, 80 km/h) -->
    <ots:Link Id="L7b" NodeStart="R7_curve_end" NodeEnd="N3_4" Type="RAMP80" OffsetEnd="-3.6m">
      <ots:Bezier />
      <ots:DefinedLayout>1LaneHighway80</ots:DefinedLayout>
    </ots:Link>

  </ots:Network>

  <ots:Demand>
    <!-- Mainline sink (vehicles leave at N5_3) -->
    <ots:Sink Lane="Lane2" Link="L5a" Position="END-50m" Type="NL.ROAD_USERS" />
    <ots:Sink Lane="Lane1" Link="L5a" Position="END-50m" Type="NL.ROAD_USERS" />
    <!-- Exit ramp sink (vehicles that took the off-ramp leave at R6_8) -->
    <ots:Sink Lane="Lane1" Link="L6_ramp" Position="END-10m" Type="NL.ROAD_USERS" />
  </ots:Demand>

  <ots:Run>
    <ots:RunLength>1h</ots:RunLength>
  </ots:Run>
</ots:Ots>
