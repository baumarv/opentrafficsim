    <ots:LinkTypes>
      <ots:LinkType Id="HIGHWAY">
        <ots:Compatibility GtuType="NL.VEHICLE" />
        <ots:SpeedLimit GtuType="NL.CAR" LegalSpeedLimit="120km/h" />
        <ots:SpeedLimit GtuType="NL.TRUCK" LegalSpeedLimit="90km/h" />
      </ots:LinkType>
      <ots:LinkType Id="LOCAL">
        <ots:Compatibility GtuType="NL.VEHICLE" />
        <ots:SpeedLimit GtuType="NL.CAR" LegalSpeedLimit="65km/h" />
        <ots:SpeedLimit GtuType="NL.TRUCK" LegalSpeedLimit="65km/h" />
      </ots:LinkType>
    </ots:LinkTypes>

    <ots:RoadLayouts>
      <!-- 3-lane: FORWARD1=leftmost (fast lane), FORWARD3=rightmost (ramp zone).
           Used with OffsetStart/End=-3.6m so that:
             FORWARD1 (9.0-3.6=5.4m) and FORWARD2 (5.4-3.6=1.8m) align with adjacent 2-lane links,
             FORWARD3 (1.8-3.6=-1.8m) is the new rightmost lane with no upstream/downstream counterpart. -->
      <ots:RoadLayout Id="3LaneHighway" LinkType="HIGHWAY">
        <ots:Shoulder Id="LeftShoulder">
          <ots:CenterOffset>12.1m</ots:CenterOffset>
          <ots:Width>3m</ots:Width>
        </ots:Shoulder>
        <ots:Stripe Id="1">
          <ots:CenterOffset>10.8m</ots:CenterOffset>
          <ots:DefinedStripe>NL.SOLID</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Lane Id="FORWARD1" LaneType="NL.HIGHWAY">
          <ots:CenterOffset>9.0m</ots:CenterOffset>
          <ots:Width>3.6m</ots:Width>
        </ots:Lane>
        <ots:Stripe Id="2">
          <ots:CenterOffset>7.2m</ots:CenterOffset>
          <ots:DefinedStripe>NL.DASHED</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Lane Id="FORWARD2" LaneType="NL.HIGHWAY">
          <ots:CenterOffset>5.4m</ots:CenterOffset>
          <ots:Width>3.6m</ots:Width>
        </ots:Lane>
        <ots:Stripe Id="3">
          <ots:CenterOffset>3.6m</ots:CenterOffset>
          <ots:DefinedStripe>NL.DASHED</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Lane Id="FORWARD3" LaneType="NL.HIGHWAY">
          <ots:CenterOffset>1.8m</ots:CenterOffset>
          <ots:Width>3.6m</ots:Width>
        </ots:Lane>
        <ots:Stripe Id="4">
          <ots:CenterOffset>0m</ots:CenterOffset>
          <ots:DefinedStripe>NL.SOLID</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Shoulder Id="RightShoulder">
          <ots:CenterOffset>-1.5m</ots:CenterOffset>
          <ots:Width>3m</ots:Width>
        </ots:Shoulder>
      </ots:RoadLayout>

      <!-- 2-lane: FORWARD1=leftmost (fast lane), FORWARD2=rightmost -->
      <ots:RoadLayout Id="2LaneHighway" LinkType="HIGHWAY">
        <ots:Shoulder Id="LeftShoulder">
          <ots:CenterOffset>8.5m</ots:CenterOffset>
          <ots:Width>3m</ots:Width>
        </ots:Shoulder>
        <ots:Stripe Id="1">
          <ots:CenterOffset>7.2m</ots:CenterOffset>
          <ots:DefinedStripe>NL.SOLID</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Lane Id="FORWARD1" LaneType="NL.HIGHWAY">
          <ots:CenterOffset>5.4m</ots:CenterOffset>
          <ots:Width>3.6m</ots:Width>
        </ots:Lane>
        <ots:Stripe Id="2">
          <ots:CenterOffset>3.6m</ots:CenterOffset>
          <ots:DefinedStripe>NL.DASHED</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Lane Id="FORWARD2" LaneType="NL.HIGHWAY">
          <ots:CenterOffset>1.8m</ots:CenterOffset>
          <ots:Width>3.6m</ots:Width>
        </ots:Lane>
        <ots:Stripe Id="3">
          <ots:CenterOffset>0m</ots:CenterOffset>
          <ots:DefinedStripe>NL.SOLID</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Shoulder Id="RightShoulder">
          <ots:CenterOffset>-1.5m</ots:CenterOffset>
          <ots:Width>3m</ots:Width>
        </ots:Shoulder>
      </ots:RoadLayout>

      <!-- 1-lane: used for exit/entry ramps -->
      <ots:RoadLayout Id="1LaneHighway" LinkType="LOCAL">
        <ots:Shoulder Id="LeftShoulder">
          <ots:CenterOffset>4.9m</ots:CenterOffset>
          <ots:Width>3m</ots:Width>
        </ots:Shoulder>
        <ots:Stripe Id="1">
          <ots:CenterOffset>3.6m</ots:CenterOffset>
          <ots:DefinedStripe>NL.SOLID</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Lane Id="FORWARD1" LaneType="NL.HIGHWAY">
          <ots:CenterOffset>1.8m</ots:CenterOffset>
          <ots:Width>3.6m</ots:Width>
        </ots:Lane>
        <ots:Stripe Id="2">
          <ots:CenterOffset>0m</ots:CenterOffset>
          <ots:DefinedStripe>NL.SOLID</ots:DefinedStripe>
        </ots:Stripe>
        <ots:Shoulder Id="RightShoulder">
          <ots:CenterOffset>-1.5m</ots:CenterOffset>
          <ots:Width>3m</ots:Width>
        </ots:Shoulder>
      </ots:RoadLayout>
    </ots:RoadLayouts>
  </ots:Definitions>

<ots:Network>

