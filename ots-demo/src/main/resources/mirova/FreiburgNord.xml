    <ots:Node Id="R7_8" Coordinate="(974.035, 20.765)"   /> -->

     <!--
      Freiburg Nord interchange transcribed from ViSSim links 1-7.
      Coordinates in metres: X=East, Y=North.

      Mainline (south to north):
        L1a  N1_1 -> N1_4   2 lanes
        L2a  N1_4 -> N2_3   3 lanes, Offset=-3.6m  (FORWARD3 at -1.8m = exit-ramp zone)
        L3a  N2_3 -> N3_4   2 lanes
        L4a  N3_4 -> N4_3   3 lanes, Offset=-3.6m  (FORWARD3 at -1.8m = entry-ramp zone)
        L5a  N4_3 -> N5_3   2 lanes

      Lane alignment at junctions (OffsetStart/End arithmetic):
        2-lane FORWARD1=5.4m, FORWARD2=1.8m
        3-lane with Offset=-3.6m:
          FORWARD1=9.0-3.6=5.4m  -> connects to 2-lane FORWARD1
          FORWARD2=5.4-3.6=1.8m  -> connects to 2-lane FORWARD2
          FORWARD3=1.8-3.6=-1.8m -> new rightmost lane (ramp zone, no match)

      Exit ramp (ViSSim link 6): L_exit Bezier with OffsetStart=-3.6m connects
        FORWARD1 at -1.8m to L2a.FORWARD3. Then Polyline L6_ramp through the loop.
      Entry ramp (ViSSim link 7): Polyline L7a, then Bezier L7m with OffsetEnd=-3.6m
        connects FORWARD1 at -1.8m to L4a.FORWARD3.

      Note: ramp segments use Polyline (not Arc) because ViSSim spline polypoints
      do not form exact circular arcs between the chosen node pairs.
    -->

    <!-- Mainline nodes -->
    <ots:Node Id="N1_1" Coordinate="(-498.363, 44.159)"    Direction="-4.8 deg(E)" />
    <ots:Node Id="N1_4" Coordinate="(522.867, -10.759)"   Direction="2.73 deg(E)" />
    <ots:Node Id="N2_3" Coordinate="(748.552, 0.003)"   /> 
    <!-- Direction="6.67 deg(E)"  -->
    <ots:Node Id="N3_4" Coordinate="(974.797, 26.438)"  Direction="9.08 deg(E)" />
    <ots:Node Id="N4_3" Coordinate="(1171.765, 57.909)" Direction="10.87 deg(E)" />
    <ots:Node Id="N5_3" Coordinate="(1888.565, 247.133)" Direction="11.2 deg(E)" />

    <!-- Exit ramp terminal nodes (ViSSim link 6 first and last polypoints) -->
    <ots:Node Id="R6_1" Coordinate="(754.174, -2.967)"    Direction="1.4 deg(E)" />
    <ots:Node Id="R6_8" Coordinate="(659.974, -126.526)"  Direction="-184.0 deg(E)" />

    <!-- Entry ramp nodes (ViSSim link 7: R7_1=generator origin, R7_8=merge connector start) -->
    <ots:Node Id="R7_1" Coordinate="(725.000, -160.000)"  Direction="6.6 deg(E)" />
    <ots:Node Id="R7_8" Coordinate="(974.035, 20.765)"  Direction="13.7 deg(E)" />
    <ots:Node Id="R7_curve_end" Coordinate="(836.402, -70.643)" Direction="52.4 deg(E)" />

    <!-- ================================================================
         MAINLINE
         ================================================================ -->

    <!-- L1a: 2-lane (ViSSim link 1) -->
    <ots:Link Id="L1a" NodeStart="N1_1" NodeEnd="N1_4" Type="HIGHWAY">
      <ots:Polyline>
        <ots:Coordinate>(-0.117, 2.320)</ots:Coordinate>
        <ots:Coordinate>(22.747, 0.295)</ots:Coordinate>
        <ots:Coordinate>(45.606, -1.801)</ots:Coordinate>
        <ots:Coordinate>(68.475, -3.754)</ots:Coordinate>
        <ots:Coordinate>(91.370, -5.346)</ots:Coordinate>
        <ots:Coordinate>(164.839, -9.286)</ots:Coordinate>
        <ots:Coordinate>(238.357, -12.370)</ots:Coordinate>
        <ots:Coordinate>(311.906, -14.393)</ots:Coordinate>
        <ots:Coordinate>(385.469, -15.147)</ots:Coordinate>
        <ots:Coordinate>(419.829, -14.681)</ots:Coordinate>
        <ots:Coordinate>(454.177, -13.514)</ots:Coordinate>
        <ots:Coordinate>(488.521, -12.066)</ots:Coordinate>
      </ots:Polyline>
      <ots:DefinedLayout>2LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- L2a: 3-lane (ViSSim link 2).
         OffsetStart/End=-3.6m: FORWARD1/2 align with L1a/L3a; FORWARD3 is the exit-ramp zone.  -->
    <ots:Link Id="L2a" NodeStart="N1_4" NodeEnd="N2_3" Type="HIGHWAY" OffsetStart="-3.6m" OffsetEnd="-3.6m">
        <ots:Straight />
      <!-- <ots:Polyline>
        <ots:Coordinate>(659.241, -8.155)</ots:Coordinate>
      </ots:Polyline> -->
      <ots:DefinedLayout>WeavingSegment</ots:DefinedLayout>
    </ots:Link>

    <!-- L3a: 2-lane (ViSSim link 3) -->
    <ots:Link Id="L3a" NodeStart="N2_3" NodeEnd="N3_4" Type="HIGHWAY">
    <!-- <ots:Straight /> -->
      <ots:Polyline>
        <ots:Coordinate>(822.470, 8.511)</ots:Coordinate>
        <ots:Coordinate>(971.629, 25.995)</ots:Coordinate>
      </ots:Polyline>
      <ots:DefinedLayout>2LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- L4a: 3-lane (ViSSim link 4).
         OffsetStart/End=-3.6m: FORWARD1/2 align with L3a/L5a; FORWARD3 is the entry-ramp zone. -->
    <ots:Link Id="L4a" NodeStart="N3_4" NodeEnd="N4_3" Type="HIGHWAY"
              OffsetStart="-3.6m" OffsetEnd="-3.6m">
              <ots:Straight />
      <!-- <ots:Polyline>
        <ots:Coordinate>(1060.734, 36.703)</ots:Coordinate>
      </ots:Polyline> -->
      <ots:DefinedLayout>WeavingSegment</ots:DefinedLayout>
    </ots:Link>

    <!-- L5a: 2-lane (ViSSim link 5) -->
    <ots:Link Id="L5a" NodeStart="N4_3" NodeEnd="N5_3" Type="HIGHWAY">
    <ots:Polyline>
        <ots:Coordinate>(1182.629, 59.782)</ots:Coordinate>
        <ots:Coordinate>(1193.496, 61.637)</ots:Coordinate>
        <ots:Coordinate>(1204.357, 63.528)</ots:Coordinate>
        <ots:Coordinate>(1215.201, 65.509)</ots:Coordinate>
        <ots:Coordinate>(1273.316, 76.362)</ots:Coordinate>
        <ots:Coordinate>(1331.403, 87.401)</ots:Coordinate>
        <ots:Coordinate>(1389.321, 99.217)</ots:Coordinate>
        <ots:Coordinate>(1446.930, 112.401)</ots:Coordinate>
        <ots:Coordinate>(1511.757, 129.275)</ots:Coordinate>
        <ots:Coordinate>(1576.189, 147.646)</ots:Coordinate>
        <ots:Coordinate>(1640.360, 166.966)</ots:Coordinate>
        <ots:Coordinate>(1704.400, 186.684)</ots:Coordinate>
        <ots:Coordinate>(1750.591, 201.325)</ots:Coordinate>
        <ots:Coordinate>(1796.616, 216.490)</ots:Coordinate>
        <ots:Coordinate>(1842.574, 231.864)</ots:Coordinate>
      </ots:Polyline>
      <ots:DefinedLayout>2LaneHighway</ots:DefinedLayout>
    </ots:Link>

    <!-- ================================================================
         EXIT RAMP (ViSSim link 6)
         L_exit: Bezier with OffsetStart=-3.6m places FORWARD1 at 1.8-3.6=-1.8m
           at N2_3, matching L2a.FORWARD3 there.
         L6_ramp: Polyline through all ViSSim link-6 intermediate polypoints.
         ================================================================ -->

    <ots:Link Id="L_exit" NodeStart="N2_3" NodeEnd="R6_1" Type="LOCAL" OffsetStart="-3.6m">
      <ots:Bezier />
      <ots:DefinedLayout>1LaneHighway</ots:DefinedLayout>
