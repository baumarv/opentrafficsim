    <!-- Entry ramp merge: Bezier with OffsetEnd=-3.6m aligns FORWARD1 with L4a.FORWARD3. -->
    <ots:Link Id="L7a" NodeStart="R7_1" NodeEnd="N3_4" Type="LOCAL" OffsetEnd="-3.6m">
      <ots:Bezier />
      <ots:DefinedLayout>1LaneHighway</ots:DefinedLayout>
    </ots:Link>

  </ots:Network>

  <ots:Demand>
    <!-- Mainline sink (vehicles leave at N5_3) -->
    <ots:Sink Lane="FORWARD1" Link="L5a" Position="END-50m" Type="NL.ROAD_USERS" />
    <ots:Sink Lane="FORWARD2" Link="L5a" Position="END-50m" Type="NL.ROAD_USERS" />
    <!-- Exit ramp sink (vehicles that took the off-ramp leave at R6_8) -->
    <ots:Sink Lane="FORWARD1" Link="L6_ramp" Position="END-10m" Type="NL.ROAD_USERS" />
  </ots:Demand>

  <ots:Run>
    <ots:RunLength>1h</ots:RunLength>
  </ots:Run>
</ots:Ots>
